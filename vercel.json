{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/wallet"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "/api/wallet"
    }
  ],
  "crons": [
    {
      "path": "/api/relances",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/recap",
      "schedule": "0 8 * * 1"
    }
  ]
}
